# Copy to .env.local for local development. In production, set the same
# variables in the host (e.g. Vercel: Settings > Environment Variables) and
# redeploy: changes only take effect on a new deployment.

# ── Database (Supabase: Project Settings > API Keys) ─────────────────────────
# Project URL only, with no path: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Secret key (sb_secret_...). Server only: never give it a NEXT_PUBLIC_ prefix.
# This is not the publishable key: that one has no access to this database.
SUPABASE_SECRET_KEY=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# /admin password.
ADMIN_PASSWORD=
# Signs session cookies. At least 32 random characters (openssl rand -base64 48).
AUTH_SESSION_SECRET=
# One passcode per partner, named in src/lib/partners.ts.
PARTNER_LTBT_PASSCODE=
